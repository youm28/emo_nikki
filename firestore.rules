rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // v1は認証なしの実験用: 感情記録の追加(create)・読み取り(read)・
    // 直近記録の上書き(update)を許可（期限なし）。削除(delete)は許可しない。
    match /users/{userId}/emotions/{docId} {
      allow read, create, update: if true;
    }

    // 日記は1日1件。ドキュメントIDが日付(yyyy-MM-dd)なので、
    // 書き直しは同じ1件のupdateになる。削除(delete)は許可しない。
    match /users/{userId}/diaries/{day} {
      allow read, create, update: if true;
    }
  }
}
