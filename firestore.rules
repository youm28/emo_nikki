rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // v1は認証なしの実験用: 感情記録の追加(create)・読み取り(read)・
    // 直近記録の上書き(update)を許可（期限なし）。削除(delete)は許可しない。
    match /users/{userId}/emotions/{docId} {
      allow read, create, update: if true;
    }

    // 日記は1日1件。ドキュメントIDが日付(yyyy-MM-dd)なので、
    // 書き直しは同じ1件のupdateになる。削除(delete)は許可しない。
    match /users/{userId}/diaries/{day} {
      allow read, create, update: if true;
    }

    // 通知用の端末トークン。ドキュメントIDがトークンそのものなので
    // 同じ端末から何度登録しても増えない。
    // 送信側(Admin SDK)はルールを介さず読むので、read は不要だが
    // 登録状態をアプリから確認できるよう許可しておく。
    match /users/{userId}/tokens/{token} {
      allow read, create, update: if true;
    }

    // 開発用（試作）の保存場所。写真と試作の日記。
    //
    // {key} は開発用パスワードから作る64桁の値で、アプリにも GitHub にも
    // 書かれていない（lib/dev_crypto.dart）。これを知らないとパスを組み立て
    // られないので、読み書きできない。
    // /dev/{key} 自体には規則を置かない＝ dev の一覧を取ってキーを知ることはできない。
    // 写真は自分で消せるよう delete も許可する。
    match /dev/{key}/photos/{photoId} {
      allow read, create, delete: if key.size() == 64;
    }
    match /dev/{key}/diaries/{docId} {
      allow read, create, update: if key.size() == 64;
    }
  }
}
